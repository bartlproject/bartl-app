---
// SPDX-License-Identifier: Apache-2.0
import MainLayout from "@/layouts/MainLayout.astro";
import InteractivePseudoCode from "@/components/InteractivePseudoCode.astro";
import GermanLanding from "@/components/GermanLanding.astro";
import { SITE } from "@/data/constants";
import { languages, type Lang } from "@/i18n/ui";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const copy = {
  en: {
    heroTitle: "One mechanism for your application's entire lifecycle.",
    heroSub: "Whatever the starting point, you'll be up and running.",
    codeLabel: "The complete decision tree.",
    codeCaption:
      "A design pattern for application lifecycle. The mechanism branches on what it finds, not on what operation was requested.",
    factsTitle: "Three facts determine the operation.",
    fact1Title: "Does local state exist?",
    fact1Body: "Reboot -> serving. No state -> restore or install.",
    fact2Title: "Is a valid backup available?",
    fact2Body: "Backup found -> restore. No backup -> fresh install.",
    fact3Title: "Engine version vs state version?",
    fact3Body:
      "Equal -> serving. Engine newer -> migrate. Engine older -> abort.",
    q1: "How many customers affected?",
    q2: "How fast back online?",
    q3: "How much data lost?",
    discoveryP1:
      "Bartl turns application-state recovery from a manual procedure into a repeatable mechanism.",
    discoveryP2:
      "Not by adding something - by replacing five separate procedures with one unified mechanism.",
    disc1: "Automate disaster recovery -> installation comes free.",
    disc2: "Add version detection -> upgrades come free.",
    disc3: "Run it on a different server -> migration comes free.",
    disc4:
      "Keep the backup portable -> application-state portability comes free.",
    discoveryP3:
      "Disaster, cost pressure, contract end, curiosity: the reason you move does not change Bartl's restore operation. The surrounding path still does - provisioning, transfer, reachability, and cutover determine end-to-end time. Bartl provides the application-and-state mechanism required for Wechselfähigkeit.",
    whoTitle: "Who this is for",
    who1: "You run applications in production and need recovery that rehearses itself with every deployment.",
    who2: "You need data isolation and separate compliance boundaries per customer.",
    who3: "You want to scale operations linearly - Nth stack adds work, not complexity.",
    who4: "You want to move your application and state to a compatible target on your terms, on your timeline.",
    ctaLicense: "Apache-2.0 / CC-BY-4.0.",
    ctaGithub: "GitHub",
  },
};

const c = copy.en;
const description =
  lang === "de"
    ? "Ein beobachteter, getesteter App- und Zustands-Startpfad für Install, Restore und Migration mit klaren Voraussetzungen und Grenzen."
    : undefined;
---

<MainLayout title={SITE.title} lang={lang} description={description}>
  {
    lang === "de" ? (
      <GermanLanding />
    ) : (
      <div class="mx-auto max-w-3xl space-y-20 px-4 py-16 sm:py-24">
        {/* Section 1: Hero */}
        <section class="space-y-4">
          <h1 class="text-3xl leading-tight font-medium sm:text-4xl lg:text-5xl">
            {c.heroTitle}
          </h1>
          <p class="text-base-content/70 text-lg">{c.heroSub}</p>
        </section>

        {/* Section 2: The decision tree */}
        <section class="space-y-4">
          <p class="text-lg font-semibold">{c.codeLabel}</p>
          <InteractivePseudoCode lang={lang} />
          <p class="text-base-content/70">{c.codeCaption}</p>
        </section>

        {/* Section 3: The discovery */}
        <section class="space-y-6">
          <div class="space-y-2">
            <p class="text-2xl leading-tight font-light">{c.q1}</p>
            <p class="text-2xl leading-tight font-light">{c.q2}</p>
            <p class="text-2xl leading-tight font-light">{c.q3}</p>
          </div>
          <p>{c.discoveryP1}</p>
          <p>{c.discoveryP2}</p>
          <div class="space-y-2 font-mono text-sm">
            <p>{c.disc1}</p>
            <p>{c.disc2}</p>
            <p>{c.disc3}</p>
            <p>{c.disc4}</p>
          </div>
          <p>{c.discoveryP3}</p>
        </section>

        {/* Section 5: Who this is for */}
        <section class="space-y-4">
          <h2 class="text-2xl font-semibold">{c.whoTitle}</h2>
          <ul class="text-base-content/80 list-inside list-disc space-y-3">
            <li>{c.who1}</li>
            <li>{c.who2}</li>
            <li>{c.who3}</li>
            <li>{c.who4}</li>
          </ul>
        </section>
      </div>
    )
  }
</MainLayout>
