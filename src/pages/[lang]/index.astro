---
// SPDX-License-Identifier: Apache-2.0
import Landing from "@/components/Landing.astro";
import { SITE } from "@/data/constants";
import { languages, type Lang } from "@/i18n/ui";
import MainLayout from "@/layouts/MainLayout.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const description =
  lang === "de"
    ? "Bartl ist ein offenes Entwurfsmuster, das den Startpfad zustandsbehafteter Anwendungen aus Zustand, Sicherung und Versionen wählt."
    : "Bartl is an open design pattern that selects a stateful application's startup path from state, backup availability, and versions.";
---

<MainLayout title={SITE.title} lang={lang} description={description}>
  <Landing lang={lang} />
</MainLayout>
