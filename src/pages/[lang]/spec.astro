---
// SPDX-License-Identifier: Apache-2.0
import PseudoCode from "@/components/PseudoCode.astro";
import { specCopy } from "@/content/spec";
import { SITE } from "@/data/constants";
import { languages, type Lang } from "@/i18n/ui";
import MainLayout from "@/layouts/MainLayout.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const c = specCopy[lang];
---

<MainLayout title={c.pageTitle} lang={lang} description={c.description}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:grid lg:grid-cols-4 lg:gap-12 lg:px-8 lg:py-20">
    <aside class="hidden lg:block">
      <nav class="sticky top-24" aria-label={c.toc}>
        <p class="text-base-content/50 text-sm font-semibold tracking-wide uppercase">{c.toc}</p>
        <ul class="mt-4 space-y-3 text-sm">
          {c.nav.map(([id, label]) => (
            <li>
              <a
                href={`#${id}`}
                class="text-base-content/70 hover:text-base-content focus-visible:outline-primary rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <article class="min-w-0 lg:col-span-3">
      <header class="border-base-300 border-b pb-10">
        <p class="text-primary font-mono text-xs font-semibold tracking-widest uppercase">{c.eyebrow}</p>
        <h1 class="mt-3 text-4xl leading-tight font-medium sm:text-5xl">{c.title}</h1>
        <p class="text-base-content/70 mt-5 max-w-3xl text-lg leading-relaxed sm:text-xl">{c.lead}</p>
        <p class="border-primary mt-8 border-l-2 pl-5 text-lg leading-relaxed">{c.principle}</p>
      </header>

      <section id="contract" aria-labelledby="contract-title" class="scroll-mt-24 py-12 sm:py-16">
        <h2 id="contract-title" class="text-3xl leading-tight">{c.contractTitle}</h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">{c.contractIntro}</p>
        <div class="border-base-300 mt-8 overflow-x-auto border-y">
          <table class="table w-full">
            <thead>
              <tr>
                <th scope="col">{c.inputLabel}</th>
                <th scope="col">{c.meaningLabel}</th>
              </tr>
            </thead>
            <tbody>
              {c.inputs.map(([input, meaning]) => (
                <tr>
                  <th scope="row" class="align-top font-medium">{input}</th>
                  <td class="text-base-content/70 leading-relaxed">{meaning}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="mt-10 text-xl">{c.observationsTitle}</h3>
        <ol class="mt-5 space-y-4">
          {c.observations.map((item, index) => (
            <li class="grid grid-cols-12 gap-4">
              <span aria-hidden="true" class="text-primary col-span-1 font-mono text-sm">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="col-span-11 leading-relaxed">{item}</span>
            </li>
          ))}
        </ol>
      </section>

      <section id="decision" aria-labelledby="decision-title" class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16">
        <h2 id="decision-title" class="text-3xl leading-tight">{c.decisionTitle}</h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">{c.decisionIntro}</p>
        <div class="mt-8">
          <PseudoCode lang={lang} />
        </div>
        <h3 class="mt-10 text-xl">{c.pathTitle}</h3>
        <dl class="border-base-300 mt-5 border-t">
          {c.paths.map(([observation, result]) => (
            <div class="border-base-300 grid gap-2 border-b py-5 sm:grid-cols-3 sm:gap-8">
              <dt class="font-medium">{observation}</dt>
              <dd class="text-base-content/70 leading-relaxed sm:col-span-2">{result}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="invariants" aria-labelledby="invariants-title" class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16">
        <h2 id="invariants-title" class="text-3xl leading-tight">{c.invariantsTitle}</h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">{c.invariantsIntro}</p>
        <dl class="border-base-300 mt-8 border-t">
          {c.invariants.map((invariant) => (
            <div class="border-base-300 grid gap-2 border-b py-5 sm:grid-cols-3 sm:gap-8">
              <dt class="font-medium">{invariant.title}</dt>
              <dd class="text-base-content/70 leading-relaxed sm:col-span-2">{invariant.body}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="product" aria-labelledby="product-title" class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16">
        <h2 id="product-title" class="text-3xl leading-tight">{c.productTitle}</h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">{c.productIntro}</p>
        <ul class="mt-8 grid gap-x-10 gap-y-4 sm:grid-cols-2">
          {c.productRequirements.map((requirement) => (
            <li class="border-primary border-l-2 pl-4 leading-relaxed">{requirement}</li>
          ))}
        </ul>
        <div class="bg-base-200/50 border-base-300 mt-10 border p-6">
          <h3 class="text-xl">{c.servingTitle}</h3>
          <p class="text-base-content/70 mt-3 leading-relaxed">{c.servingBody}</p>
        </div>
      </section>

      <section id="reference" aria-labelledby="reference-title" class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16">
        <h2 id="reference-title" class="text-3xl leading-tight">{c.referenceTitle}</h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">{c.referenceIntro}</p>
        <dl class="border-base-300 mt-8 border-t">
          {c.referenceRows.map(([term, detail]) => (
            <div class="border-base-300 grid gap-2 border-b py-5 sm:grid-cols-3 sm:gap-8">
              <dt class="font-mono text-sm">{term}</dt>
              <dd class="text-base-content/70 leading-relaxed sm:col-span-2">{detail}</dd>
            </div>
          ))}
        </dl>
        <a
          href={SITE.reference}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={c.referenceAria}
          class="btn btn-primary mt-8 focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {c.referenceLink}
        </a>
      </section>

      <section id="boundary" aria-labelledby="boundary-title" class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16">
        <h2 id="boundary-title" class="text-3xl leading-tight">{c.boundaryTitle}</h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">{c.boundaryIntro}</p>
        <div class="mt-8 grid gap-10 sm:grid-cols-2 sm:gap-12">
          <div>
            <h3 class="text-xl">{c.insideTitle}</h3>
            <ul class="mt-5 space-y-3">
              {c.inside.map((item) => (
                <li class="border-primary border-l-2 pl-4 leading-relaxed">{item}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-xl">{c.outsideTitle}</h3>
            <ul class="text-base-content/70 mt-5 space-y-3">
              {c.outside.map((item) => (
                <li class="border-base-300 border-l-2 pl-4 leading-relaxed">{item}</li>
              ))}
            </ul>
          </div>
        </div>
        <p class="border-base-300 mt-10 border-t pt-8 leading-relaxed">{c.closing}</p>
        <a
          href={`/${lang}/`}
          class="link text-base-content/70 hover:text-base-content focus-visible:outline-primary mt-8 inline-block rounded-sm underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {c.back}
        </a>
      </section>
    </article>
  </div>
</MainLayout>
