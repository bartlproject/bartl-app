---
// SPDX-License-Identifier: Apache-2.0
import PseudoCode from "@/components/PseudoCode.astro";
import { derivationCopy } from "@/content/derivation";
import { SITE } from "@/data/constants";
import { languages, type Lang } from "@/i18n/ui";
import MainLayout from "@/layouts/MainLayout.astro";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const c = derivationCopy[lang];
---

<MainLayout title={c.pageTitle} lang={lang} description={c.description}>
  <div
    class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:grid lg:grid-cols-4 lg:gap-12 lg:px-8 lg:py-20"
  >
    <aside class="hidden lg:block">
      <nav class="sticky top-24" aria-label={c.toc}>
        <p
          class="text-base-content/50 text-sm font-semibold tracking-wide uppercase"
        >
          {c.toc}
        </p>
        <ul class="mt-4 space-y-3 text-sm">
          {
            c.nav.map(([id, label]) => (
              <li>
                <a
                  href={`#${id}`}
                  class="text-base-content/70 hover:text-base-content focus-visible:outline-primary rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <article class="min-w-0 lg:col-span-3">
      <header class="border-base-300 border-b pb-10">
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.eyebrow}
        </p>
        <h1
          class="mt-3 text-4xl leading-tight font-medium text-balance sm:text-5xl"
        >
          {c.title}
        </h1>
        <p
          class="text-base-content/70 mt-5 max-w-3xl text-lg leading-relaxed sm:text-xl"
        >
          {c.lead}
        </p>
        <p class="border-primary mt-8 border-l-2 pl-5 text-lg leading-relaxed">
          {c.principle}
        </p>
      </header>

      <section
        id="experience"
        aria-labelledby="experience-title"
        class="scroll-mt-24 py-12 sm:py-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.experienceEyebrow}
        </p>
        <h2
          id="experience-title"
          class="mt-3 text-4xl leading-tight sm:text-5xl"
        >
          {c.experienceTitle}
        </h2>
        <p class="mt-5 max-w-3xl text-xl leading-relaxed">{c.experienceLead}</p>

        <div
          class="border-base-300 mt-10 grid overflow-hidden border sm:grid-cols-2"
        >
          {
            c.phoneCases.map(([situation, response], index) => (
              <div
                class:list={[
                  "p-6",
                  index % 2 === 1 && "sm:border-l",
                  index > 1 && "border-t",
                ]}
              >
                <p class="text-base-content/60 text-sm leading-relaxed">
                  {situation}
                </p>
                <p class="text-primary mt-3 font-mono text-sm">
                  -&gt; {response}
                </p>
              </div>
            ))
          }
        </div>

        <div class="bg-base-200/50 border-base-300 mt-8 border p-6 sm:p-8">
          <h3 class="text-xl">{c.analogyTitle}</h3>
          <p class="text-base-content/70 mt-3 leading-relaxed">
            {c.analogyBody}
          </p>
        </div>
      </section>

      <section
        id="journey"
        aria-labelledby="journey-title"
        class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.journeyEyebrow}
        </p>
        <h2 id="journey-title" class="mt-3 text-3xl leading-tight">
          {c.journeyTitle}
        </h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">
          {c.journeyLead}
        </p>

        <ol class="border-base-300 mt-10 border-t">
          {
            c.journey.map((stage) => (
              <li class="border-base-300 grid gap-3 border-b py-6 sm:grid-cols-4 sm:gap-8">
                <p class="text-primary font-mono text-sm">{stage.year}</p>
                <div class="sm:col-span-3">
                  <h3 class="text-lg">{stage.title}</h3>
                  <p class="text-base-content/70 mt-2 leading-relaxed">
                    {stage.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        id="observations"
        aria-labelledby="observations-title"
        class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.observationsEyebrow}
        </p>
        <h2 id="observations-title" class="mt-3 text-3xl leading-tight">
          {c.observationsTitle}
        </h2>

        <ol class="mt-10 grid gap-5 sm:grid-cols-2">
          {
            c.observations.map((observation, index) => (
              <li
                class:list={[
                  "border-base-300 border p-6",
                  index === c.observations.length - 1 && "sm:col-span-2",
                ]}
              >
                <p aria-hidden="true" class="text-primary font-mono text-sm">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <h3 class="mt-5 text-xl">{observation.title}</h3>
                <p class="text-base-content/70 mt-3 leading-relaxed">
                  {observation.body}
                </p>
              </li>
            ))
          }
        </ol>
      </section>

      <section
        id="pressure"
        aria-labelledby="pressure-title"
        class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.pressureEyebrow}
        </p>
        <h2 id="pressure-title" class="mt-3 text-3xl leading-tight">
          {c.pressureTitle}
        </h2>

        <dl class="border-base-300 mt-8 border-t">
          {
            c.pressures.map(([condition, requirement]) => (
              <div class="border-base-300 grid gap-3 border-b py-5 sm:grid-cols-2 sm:items-center sm:gap-10">
                <dt class="text-base-content/70 leading-relaxed">
                  {condition}
                </dt>
                <dd class="border-primary border-l-2 pl-4 leading-relaxed">
                  {requirement}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="bg-neutral text-neutral-content mt-10 p-6 sm:p-8">
          <h3 class="text-xl">{c.designObjectiveTitle}</h3>
          <p class="text-neutral-content/70 mt-3 text-lg leading-relaxed">
            {c.designObjective}
          </p>
        </div>
      </section>

      <section
        id="discovery"
        aria-labelledby="discovery-title"
        class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.discoveryEyebrow}
        </p>
        <h2 id="discovery-title" class="mt-3 text-3xl leading-tight">
          {c.discoveryTitle}
        </h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">
          {c.discoveryLead}
        </p>

        <div class="mt-8 flex flex-wrap gap-2" aria-label={c.discoveryTitle}>
          {
            ["Install", "Restore", "Upgrade", "Reboot", "Migration"].map(
              (operation) => (
                <span class="badge badge-outline badge-lg font-mono">
                  {operation}
                </span>
              ),
            )
          }
        </div>

        <ol class="mt-8 grid gap-3 sm:grid-cols-3">
          {
            c.facts.map((fact, index) => (
              <li class="bg-base-200/50 border-base-300 border p-5">
                <p class="text-primary font-mono text-xs">
                  {String(index + 1).padStart(2, "0")}
                </p>
                <p class="mt-3 leading-relaxed">{fact}</p>
              </li>
            ))
          }
        </ol>

        <p class="mt-8 max-w-3xl text-lg leading-relaxed">{c.discoveryBody}</p>
        <div class="mt-8">
          <PseudoCode lang={lang} />
        </div>
        <a
          href={`/${lang}/#mechanism`}
          class="link text-base-content/70 hover:text-base-content focus-visible:outline-primary mt-6 inline-block rounded-sm underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {c.decisionLink}
        </a>
      </section>

      <section
        id="effects"
        aria-labelledby="effects-title"
        class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.effectsEyebrow}
        </p>
        <h2 id="effects-title" class="mt-3 text-3xl leading-tight">
          {c.effectsTitle}
        </h2>

        <div class="mt-10 grid gap-10 sm:grid-cols-2 sm:gap-12">
          <div>
            <h3 class="text-xl">{c.structuralTitle}</h3>
            <ul class="mt-5 space-y-4">
              {
                c.structural.map((item) => (
                  <li class="border-primary border-l-2 pl-4 leading-relaxed">
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="border-base-300 sm:border-l sm:pl-12">
            <h3 class="text-xl">{c.expectedTitle}</h3>
            <p class="text-base-content/70 mt-3 leading-relaxed">
              {c.expectedIntro}
            </p>
            <ul class="text-base-content/70 mt-5 space-y-4">
              {
                c.expected.map((item) => (
                  <li class="border-base-300 border-l-2 pl-4 leading-relaxed">
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section
        id="composition"
        aria-labelledby="composition-title"
        class="border-base-300 scroll-mt-24 border-t py-12 sm:py-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.compositionEyebrow}
        </p>
        <h2 id="composition-title" class="mt-3 text-3xl leading-tight">
          {c.compositionTitle}
        </h2>
        <p class="text-base-content/70 mt-4 max-w-3xl leading-relaxed">
          {c.compositionLead}
        </p>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {
            c.compositionParts.map((part, index) => (
              <section
                class="border-base-300 relative border p-6"
                aria-labelledby={`composition-part-${index}`}
              >
                <p class="text-primary font-mono text-xs tracking-widest uppercase">
                  {part.label}
                </p>
                <h3 id={`composition-part-${index}`} class="mt-3 text-xl">
                  {part.title}
                </h3>
                <ul class="text-base-content/70 mt-5 space-y-3">
                  {part.items.map((item) => (
                    <li class="border-base-300 border-l-2 pl-3 text-sm leading-relaxed">
                      {item}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        <div class="bg-base-200/50 border-base-300 mt-8 border p-6 sm:p-8">
          <h3 class="text-xl">{c.combinedTitle}</h3>
          <p class="text-base-content/70 mt-3 leading-relaxed">
            {c.combinedBody}
          </p>
        </div>
        <p class="border-primary mt-8 border-l-2 pl-5 leading-relaxed">
          {c.costBoundary}
        </p>
      </section>

      <section
        id="boundary"
        aria-labelledby="boundary-title"
        class="border-base-300 scroll-mt-24 border-t pt-12 sm:pt-16"
      >
        <p
          class="text-primary font-mono text-xs font-semibold tracking-widest uppercase"
        >
          {c.boundaryEyebrow}
        </p>
        <h2 id="boundary-title" class="mt-3 text-3xl leading-tight">
          {c.boundaryTitle}
        </h2>
        <p class="text-base-content/70 mt-4 max-w-3xl text-lg leading-relaxed">
          {c.boundaryBody}
        </p>

        <div
          class="border-base-300 mt-10 flex flex-col gap-5 border-y py-8 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href={`/${lang}/spec/`}
              class="btn btn-primary focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {c.specLink}
            </a>
            <a
              href={SITE.reference}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={c.referenceAria}
              class="btn btn-outline focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {c.referenceLink}
            </a>
          </div>
          <a
            href={`/${lang}/`}
            class="link text-base-content/70 hover:text-base-content focus-visible:outline-primary rounded-sm text-sm underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {c.back}
          </a>
        </div>
      </section>
    </article>
  </div>
</MainLayout>
