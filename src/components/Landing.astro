---
// SPDX-License-Identifier: Apache-2.0
import InteractivePseudoCode from "@/components/InteractivePseudoCode.astro";
import { SITE } from "@/data/constants";
import { landingCopy } from "@/content/landing";
import type { Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const quickstart = `git clone https://codeberg.org/bartlapp/bartl-wordpress.git
cd bartl-wordpress
mkdir -p backup-store
docker compose up -d`;


const c = landingCopy[lang];
---

<div class="overflow-hidden">
  <section aria-labelledby="landing-title" class="border-base-300 border-b">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
      <div class="max-w-4xl">
        <p class="text-primary mb-6 font-mono text-sm font-semibold tracking-widest uppercase">
          {c.heroEyebrow}
        </p>
        <h1 id="landing-title" class="text-4xl leading-tight font-medium text-balance sm:text-5xl lg:text-6xl">
          {c.heroTitle}
        </h1>
        <p class="text-base-content/70 mt-6 max-w-3xl text-lg leading-relaxed sm:text-xl">
          {c.heroBody}
        </p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={SITE.reference}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={c.heroPrimaryAria}
            class="btn btn-primary focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {c.heroPrimary}
          </a>
          <a
            href="#mechanism"
            class="btn btn-outline focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {c.heroSecondary}
          </a>
        </div>
        <a
          href={`/${lang}/spec/`}
          class="link text-base-content/70 hover:text-base-content focus-visible:outline-primary mt-6 inline-block rounded-sm text-sm underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {c.heroSpec}
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="problem-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-16">
      <div>
        <p class="text-base-content/50 font-mono text-xs font-semibold tracking-widest uppercase">
          {c.problemEyebrow}
        </p>
        <h2 id="problem-title" class="mt-3 text-3xl leading-tight sm:text-4xl">
          {c.problemTitle}
        </h2>
      </div>
      <div class="space-y-6 text-lg leading-relaxed lg:col-span-2">
        {c.problemBody.map((paragraph, index) => (
          <p class:list={[index === 1 && "text-base-content/70"]}>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section id="mechanism" aria-labelledby="mechanism-title" class="bg-base-200/50 border-base-300 scroll-mt-20 border-y">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-primary font-mono text-xs font-semibold tracking-widest uppercase">
          {c.mechanismEyebrow}
        </p>
        <h2 id="mechanism-title" class="mt-3 text-3xl leading-tight sm:text-4xl">
          {c.mechanismTitle}
        </h2>
        <p class="text-base-content/70 mt-4 text-lg leading-relaxed">
          {c.mechanismBody}
        </p>
      </div>

      <div class="mt-10 grid items-start gap-10 lg:grid-cols-2 lg:gap-12">
        <InteractivePseudoCode lang={lang} />
        <div>
          <h3 class="text-xl">{c.tableTitle}</h3>
          <div class="border-base-300 mt-4 overflow-x-auto border-y">
            <table class="table table-sm w-full">
              <caption class="sr-only">{c.tableCaption}</caption>
              <thead>
                <tr>
                  <th scope="col">{c.tableState}</th>
                  <th scope="col">{c.tableAction}</th>
                </tr>
              </thead>
              <tbody>
                {c.decisionRows.map(([state, action]) => (
                  <tr>
                    <th scope="row" class="font-normal">{state}</th>
                    <td class="text-base-content/70">{action}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="inputs-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-primary font-mono text-xs font-semibold tracking-widest uppercase">
        {c.inputsEyebrow}
      </p>
      <h2 id="inputs-title" class="mt-3 text-3xl leading-tight sm:text-4xl">
        {c.inputsTitle}
      </h2>
      <p class="text-base-content/70 mt-4 text-lg leading-relaxed">{c.inputsBody}</p>
    </div>

    <ol class="border-base-300 mt-10 border-t">
      {c.inputs.map((input, index) => (
        <li class="border-base-300 grid gap-4 border-b py-6 sm:grid-cols-3 sm:gap-8">
          <div class="flex items-start gap-4">
            <span aria-hidden="true" class="text-primary font-mono text-sm">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="text-lg">{input.title}</h3>
          </div>
          <p class="text-base-content/70 leading-relaxed sm:col-span-2">{input.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="reference-title" class="bg-neutral text-neutral-content">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-neutral-content/70 font-mono text-xs font-semibold tracking-widest uppercase">
            {c.referenceEyebrow}
          </p>
          <h2 id="reference-title" class="mt-3 text-3xl leading-tight sm:text-4xl">
            {c.referenceTitle}
          </h2>
          <p class="text-neutral-content/70 mt-5 text-lg leading-relaxed">{c.referenceBody}</p>
          <dl class="border-neutral-content/20 mt-8 border-t">
            {c.referenceFacts.map(([term, detail]) => (
              <div class="border-neutral-content/20 grid gap-1 border-b py-4 sm:grid-cols-3 sm:gap-6">
                <dt class="font-mono text-sm">{term}</dt>
                <dd class="text-neutral-content/70 sm:col-span-2">{detail}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="border-neutral-content/20 border-t pt-10 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-12">
          <h3 class="text-xl">{c.quickstartTitle}</h3>
          <p class="text-neutral-content/70 mt-3 leading-relaxed">{c.quickstartBody}</p>
          <pre class="bg-code-background text-code-foreground border-code-border mt-6 overflow-x-auto rounded-lg border p-4 text-sm leading-relaxed shadow-sm"><code>{quickstart}</code></pre>
          <p class="text-neutral-content/70 mt-6 text-sm leading-relaxed">{c.backupLabel}</p>
          <p class="bg-code-background text-code-foreground border-code-border mt-3 overflow-x-auto rounded-lg border p-4 font-mono text-sm shadow-sm">
            docker compose exec bartl-init /backup.sh
          </p>
          <a
            href={SITE.reference}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={c.referenceAria}
            class="btn btn-primary mt-8 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {c.referenceLink}
          </a>
          <div class="border-primary mt-10 border-l-2 pl-5">
            <h3 class="text-lg">{c.proofTitle}</h3>
            <p class="text-neutral-content/70 mt-2 text-sm leading-relaxed">{c.proofBody}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="scope-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-primary font-mono text-xs font-semibold tracking-widest uppercase">
        {c.scopeEyebrow}
      </p>
      <h2 id="scope-title" class="mt-3 text-3xl leading-tight sm:text-4xl">
        {c.scopeTitle}
      </h2>
    </div>

    <div class="border-base-300 mt-10 grid gap-10 border-y py-8 lg:grid-cols-2 lg:gap-16">
      <div>
        <h3 class="text-xl">{c.doesTitle}</h3>
        <ul class="mt-5 space-y-3">
          {c.does.map((item) => (
            <li class="border-primary border-l-2 pl-4 leading-relaxed">{item}</li>
          ))}
        </ul>
      </div>
      <div class="border-base-300 lg:border-l lg:pl-16">
        <h3 class="text-xl">{c.doesNotTitle}</h3>
        <ul class="text-base-content/70 mt-5 space-y-3">
          {c.doesNot.map((item) => (
            <li class="border-base-300 border-l-2 pl-4 leading-relaxed">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="fit-title" class="bg-base-200/50 border-base-300 border-y">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-primary font-mono text-xs font-semibold tracking-widest uppercase">
          {c.fitEyebrow}
        </p>
        <h2 id="fit-title" class="mt-3 text-3xl leading-tight sm:text-4xl">{c.fitTitle}</h2>
      </div>
      <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h3 class="text-xl">{c.suitableTitle}</h3>
          <ul class="mt-5 space-y-4">
            {c.suitable.map((item) => (
              <li class="border-primary border-l-2 pl-4 leading-relaxed">{item}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-xl">{c.unsuitableTitle}</h3>
          <ul class="text-base-content/70 mt-5 space-y-4">
            {c.unsuitable.map((item) => (
              <li class="border-base-300 border-l-2 pl-4 leading-relaxed">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="cta-title" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="border-base-300 flex flex-col gap-8 border-y py-10 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-2xl">
        <h2 id="cta-title" class="text-2xl leading-tight sm:text-3xl">{c.ctaTitle}</h2>
        <p class="text-base-content/70 mt-3 leading-relaxed">{c.ctaBody}</p>
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:items-end">
        <a
          href={SITE.reference}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={c.referenceAria}
          class="btn btn-primary focus-visible:outline-primary focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {c.ctaPrimary}
        </a>
        <a
          href={`/${lang}/spec/`}
          class="link text-base-content/70 hover:text-base-content focus-visible:outline-primary rounded-sm text-sm underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          {c.ctaSecondary}
        </a>
      </div>
    </div>
  </section>
</div>
